# -- Jira / Xray Proxy (mcporsche jira-mcp running on port 8000) --------------
XRAY_BASE_URL=http://localhost:8000

# -- Confluence Proxy (mcporsche confluence-mcp running on port 8001) ---------
LOCAL_API_URL=http://localhost:8001

# -- Confluence page ID for the SOP page (do not change) ----------------------
CONFLUENCE_PAGE_ID=2378907792

# -- Corporate HTTP proxy (Porsche office network) -----------------------------
HTTP_PROXY=http://http-proxy.porsche.org:3133
HTTPS_PROXY=http://http-proxy.porsche.org:3128

# -- Your personal Jira PAT (generate at https://skyway.porsche.com/jira ? Profile ? Personal Access Tokens) --
JIRA_API_TOKEN=your_personal_access_token_here
JIRA_EMAIL=your.email@porsche-engineering.de
JIRA_BASE_URL=https://api.skyway.porsche.com/jira

# -- Confluence PAT (same token works for Confluence too) ---------------------
CONFLUENCE_PAT=your_personal_access_token_here
CONFLUENCE_BASE_URL=https://api.skyway.porsche.com/confluence
