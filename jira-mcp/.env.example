# Get your PAT from: https://skyway.porsche.com/jira/plugins/servlet/desk/portal/1/create/9141
JIRA_PAT="XXXX"
JIRA_BASE_URL="https://api.skyway.porsche.com/jira"

# Certificate Authentication (optional - disabled by default)
# When configured, certificate auth is used instead of proxy.
# Requires OpenSSL to be installed on the system.
# CERT_PATH=/path/to/certificate.p12
# CERT_PASSWORD=your_certificate_password

# Proxy Settings (optional - used when certificate auth is not configured)
HTTP_PROXY=http://http-proxy.porsche.org:3128
HTTPS_PROXY=http://http-proxy.porsche.org:3133

# MCP Server Port
MCP_PORT=8000
# MCP Transport (optional - selects the MCP transport protocol)
# 'http' (default): SSE/HTTP transport, compatible with Claude Code and most MCP clients
# 'stdio': stdio transport, compatible with VS Code Copilot and similar tools
# MCP_TRANSPORT=http
